-- MIGRATION: Ajout des tables pour les modeles d'evenements et la gestion de l'inventaire,
-- et ajout d'une colonne de statut de sante aux animaux.

-- =================================================================
-- Instruction 1: Table pour les modeles d'evenements (event_templates)
-- =================================================================

CREATE TABLE public.event_templates (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,
  template_name TEXT NOT NULL,
  event_type TEXT NOT NULL,
  default_details JSONB,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

COMMENT ON TABLE public.event_templates IS 'Stores user-defined templates for recurring events.';

ALTER TABLE public.event_templates ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.event_templates FORCE ROW LEVEL SECURITY;

CREATE POLICY event_templates_owner_all
ON public.event_templates
FOR ALL
USING (auth.uid() = user_id OR auth.role() = 'service_role')
WITH CHECK (auth.uid() = user_id OR auth.role() = 'service_role');

-- =================================================================
-- Instruction 2: Ajout du statut de sante (health_status)
-- =================================================================

ALTER TABLE public.animals
ADD COLUMN health_status TEXT;

COMMENT ON COLUMN public.animals.health_status IS 'Stores temporary health-related statuses like "Under treatment" or "Observation".';

-- =================================================================
-- Instruction 3: Tables pour la gestion de l'inventaire
-- =================================================================

CREATE TABLE public.food_types (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,
  name TEXT NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

COMMENT ON TABLE public.food_types IS 'Lists different types of food for livestock.';

ALTER TABLE public.food_types ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.food_types FORCE ROW LEVEL SECURITY;

CREATE POLICY food_types_owner_all
ON public.food_types
FOR ALL
USING (auth.uid() = user_id OR auth.role() = 'service_role')
WITH CHECK (auth.uid() = user_id OR auth.role() = 'service_role');

CREATE TABLE public.food_stock (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE NOT NULL,
  food_type_id BIGINT REFERENCES public.food_types(id) ON DELETE SET NULL,
  quantity_kg NUMERIC(8, 2) NOT NULL,
  purchase_date DATE,
  cost NUMERIC(8, 2),
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

COMMENT ON TABLE public.food_stock IS 'Tracks the quantity and cost of food stock.';

ALTER TABLE public.food_stock ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.food_stock FORCE ROW LEVEL SECURITY;

CREATE POLICY food_stock_owner_all
ON public.food_stock
FOR ALL
USING (auth.uid() = user_id OR auth.role() = 'service_role')
WITH CHECK (auth.uid() = user_id OR auth.role() = 'service_role');
